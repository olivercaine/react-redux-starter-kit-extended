{
  "root": true,
  "parser": "@babel/eslint-parser",
  "extends": [
    "standard",
    "standard-react"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "plugins": [
    "babel",
    "react",
    "no-null",
    "promise"
  ],
  "env": {
    "browser" : true,
    "mocha" : true,
    "node": true
  },
  "globals": {
    "expect"       : false,
    "should"       : false,
    "sinon"        : false,
    "__DEV__"      : false,
    "__TEST__"     : false,
    "__PROD__"     : false,
    "__COVERAGE__" : false
  },
  "rules": {
    "indent"               : ["warn", 2, { "SwitchCase": 1 }],
    "no-unused-vars"       : "off",
    "key-spacing"          : "off",
    "jsx-quotes"           : [2, "prefer-single"],
    "max-len"              : [2, 140, 2],
    "object-curly-spacing" : [2, "always"],
    "no-null/no-null"      : 2,
    "semi"                 : [1, "never"],
    "comma-dangle"         : "off",
    "no-undef"             : "off"
  }
}
