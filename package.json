{
  "name": "react-redux-starter-kit",
  "version": "3.0.1",
  "description": "Get started with React, Redux, and React-Router!",
  "main": "src/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "compile": "node build/scripts/compile",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "npm run lint -- --fix",
    "test": "cross-env NODE_ENV=none karma start build/karma.config",
    "test:watch": "npm test -- --watch",
    "test:storybook": "start-storybook --smoke-test",
    "storybook": "start-storybook -p 6006 -s ./public",
    "dev": "npm i && concurrently 'npm run start' 'npm run storybook' 'npm run test:watch'",
    "start": "cross-env NODE_ENV=development node build/scripts/start",
    "build": "npm run clean && npm run build-storybook && cross-env NODE_ENV=production npm run compile",
    "build-storybook": "build-storybook -o ./dist/storybook",
    "health-check": "npm ci && concurrently 'npm run lint' 'npm test' 'npm run test:storybook' 'npm run build'"
  },
  "husky": {
    "hooks": {
      "post-commit": "npm run lint:fix",
      "pre-push": "npm run health-check"
    }
  },
  "engines": {
    "node": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davezuko/react-redux-starter-kit.git"
  },
  "author": "David Zukowski <david@zuko.me> (http://zuko.me)",
  "license": "MIT",
  "dependencies": {
    "@olliecaine/form-validation": "^1.0.0",
    "@olliecaine/months": "^1.0.2",
    "@olliecaine/reducers": "^1.0.8",
    "bootstrap": "^4.3.1",
    "compression": "^1.6.2",
    "express": "^4.14.0",
    "formik": "^1.5.8",
    "object-assign": "^4.1.1",
    "promise": "^7.1.1",
    "prop-types": "^15.7.2",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-redux": "^5.0.4",
    "react-router": "^3.0.0",
    "react-scripts": "^4.0.0",
    "redbox-react": "^1.3.6",
    "redux": "^3.6.0",
    "redux-thunk": "^2.2.0",
    "whatwg-fetch": "^2.0.3",
    "yup": "^0.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/eslint-parser": "^7.15.4",
    "@babel/plugin-proposal-class-properties": "^7.0.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
    "@babel/plugin-syntax-dynamic-import": "^7.0.0",
    "@babel/plugin-transform-runtime": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime-corejs2": "^7.0.0",
    "@storybook/addon-actions": "^6.4.19",
    "@storybook/addon-essentials": "^6.4.19",
    "@storybook/addon-links": "^6.4.19",
    "@storybook/builder-webpack5": "^6.4.19",
    "@storybook/core-common": "^6.4.19",
    "@storybook/manager-webpack5": "^6.4.19",
    "@storybook/node-logger": "^6.4.19",
    "@storybook/react": "^6.4.19",
    "@types/chai": "^4.1.3",
    "@types/enzyme-adapter-react-16": "^1.0.5",
    "@types/mocha": "^5.2.6",
    "@types/node": "9.6.7",
    "@types/react": "^16.8.6",
    "@types/react-dom": "^16.8.2",
    "@types/sinon": "^5.0.7",
    "@types/yup": "^0.29.7",
    "awesome-typescript-loader": "^3.2.2",
    "babel-loader": "^8.0.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^6.0.0",
    "chai-enzyme": "^1.0.0-beta.1",
    "chalk": "^1.1.3",
    "codecov": "^3.8.3",
    "concurrently": "^4.1.0",
    "connect-history-api-fallback": "^1.6.0",
    "core-js": "^2.6.12",
    "cross-env": "^5.0.0",
    "css-loader": "^6.2.0",
    "dirty-chai": "^1.2.2",
    "enzyme": "^3.9.0",
    "enzyme-adapter-react-16": "^1.10.0",
    "eslint": "^3.19.0",
    "eslint-config-standard": "^10.2.1",
    "eslint-config-standard-react": "^5.0.0",
    "eslint-plugin-babel": "^4.1.1",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-promise": "^3.5.0",
    "eslint-plugin-react": "^7.12.4",
    "eslint-plugin-standard": "^3.0.1",
    "figures": "^2.0.0",
    "file-loader": "^0.11.1",
    "fs-extra": "^3.0.1",
    "html-webpack-plugin": "^5.3.2",
    "husky": "^1.3.1",
    "karma": "^6.3.5",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-webpack": "^5.0.0",
    "mini-css-extract-plugin": "^2.4.3",
    "mocha": "^3.2.0",
    "node-sass": "^4.11.0",
    "react-addons-test-utils": "^15.5.1",
    "react-hot-loader": "^4.13.0",
    "react-test-renderer": "^15.5.4",
    "rimraf": "^2.6.3",
    "sass": "^1.32.12",
    "sass-loader": "^12.1.0",
    "sinon": "^2.2.0",
    "sinon-chai": "^2.10.0",
    "style-loader": "^3.2.1",
    "ts-node": "^6.2.0",
    "tslint": "^5.18.0",
    "typescript": "3.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.59.1",
    "webpack-cli": "^4.9.1",
    "webpack-dev-middleware": "^5.0.0",
    "webpack-dev-server": "^4.3.1",
    "webpack-hot-middleware": "^2.25.0",
    "yargs": "^8.0.1"
  },
  "eslintConfig": {
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  }
}
