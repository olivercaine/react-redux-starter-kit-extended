{
  "name": "react-redux-starter-kit",
  "version": "3.0.1",
  "description": "Get started with React, Redux, and React-Router!",
  "main": "src/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "compile": "node build/scripts/compile",
    "start": "cross-env NODE_ENV=development node build/scripts/start",
    "dev": "concurrently 'npm install' 'npm run start' 'npm run storybook' 'npm run test:watch'",
    "dev:docker": "docker run --rm -it -w /app -v ${PWD}:/app --expose 7000 -p 6006:6006 -p 3000:3000 node:14-alpine sh -c 'npm run dev'",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "npm run lint -- --fix",
    "storybook": "start-storybook -p 6006 -s ./public",
    "storybook:test": "start-test storybook 6006 'test-storybook --browsers chromium'",
    "storybook:build": "build-storybook",
    "storybook:serve": "http-server storybook-static --port 6006 --silent",
    "test": "cross-env NODE_ENV=none karma start build/karma.config",
    "test:watch": "npm test -- --watch",
    "cypress:open": "cypress open --browser chrome --e2e",
    "integration": "start-test start 3000 'cypress run --browser chrome'",
    "build": "npm run clean && cross-env NODE_ENV=production npm run compile",
    "health-check": "time concurrently --group --kill-others-on-fail 'npm run lint --quiet' 'npm run build' 'npm run storybook:build' 'npm test'"
  },
  "husky": {
    "hooks": {
      "post-commit": "npm run lint:fix",
      "pre-push": "time concurrently --group --kill-others-on-fail --timings 'npm run health-check' 'npm run storybook:test' 'npm run integration'"
    }
  },
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davezuko/react-redux-starter-kit.git"
  },
  "author": "David Zukowski <david@zuko.me> (http://zuko.me)",
  "license": "MIT",
  "dependencies": {
    "@olliecaine/fetch": "^1.0.0",
    "@olliecaine/form-validation": "^1.0.4",
    "@olliecaine/months": "^1.0.2",
    "@olliecaine/reducers": "^1.0.19",
    "bootstrap": "^4.3.1",
    "compression": "^1.6.2",
    "express": "^4.14.1",
    "formik": "^1.5.8",
    "object-assign": "^4.1.1",
    "promise": "^7.1.1",
    "prop-types": "^15.7.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^5.0.7",
    "react-router": "^3.0.5",
    "react-scripts": "^5.0.1",
    "redbox-react": "^1.3.7",
    "redux": "^3.6.0",
    "redux-thunk": "^2.2.0",
    "whatwg-fetch": "^2.0.4",
    "yup": "^0.27.0"
  },
